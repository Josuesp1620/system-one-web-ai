{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "system-one-web-ai",
  "compatibility_date": "2026-09-25",
  "build": {
    "command": "pnpm build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "system-one-web-ai.apiservicesac.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  }
}
